# Copy to .env and fill in. The corpus finder loads this file automatically.
# GitHub: fine-grained PAT, read-only, "Public repositories (read-only)" access
#         -> github.com > Settings > Developer settings > Personal access tokens
LIBRARIES_API_KEY=
GITHUB_TOKEN=

# Optional overrides (defaults live in corpus/settings.py):
# TARGET_CANDIDATES=5000     # finder stops once this many unique candidates are scraped
# CLONE_RETENTION=accepted   # all | accepted | none (see corpus/settings.py)
